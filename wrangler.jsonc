{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "radar-om",
  "main": "collector/src/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    // 05:00 UTC = 02:00 BRT abre o ciclo diário; a cada 10 min (02h–08h50 BRT) processa a fila
    "crons": ["0 5 * * *", "*/10 5-11 * * *"]
  },
  // Valores públicos do Supabase (a chave publishable só permite login; o acesso aos dados é controlado no Worker + RLS).
  "vars": {
    "SUPABASE_URL": "https://abikjfiyrnbvtgtwzhtx.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_nlBT1SZClhITjNXbOYMhTA_R1L8eJIk"
  },
  // A chave secret (sb_secret_…) NÃO vai aqui: cadastre no painel como Secret SUPABASE_SERVICE_ROLE_KEY.
  // keep_vars impede que os deploys apaguem outras variáveis cadastradas no painel.
  "keep_vars": true,
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true }, "head_sampling_rate": 1 }
}
