{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "radar-om",
  "main": "collector/src/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    // 05:00 UTC = 02:00 BRT abre o ciclo diário; a cada 10 min (02h–08h50 BRT) processa a fila
    "crons": ["0 5 * * *", "*/10 5-11 * * *"]
  },
  // As variáveis ficam no painel do Cloudflare (Settings → Variables and Secrets):
  //   SUPABASE_URL, SUPABASE_ANON_KEY (texto) e SUPABASE_SERVICE_ROLE_KEY (Secret).
  // keep_vars impede que cada deploy pelo GitHub apague o que foi cadastrado no painel.
  "keep_vars": true,
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true }, "head_sampling_rate": 1 }
}
